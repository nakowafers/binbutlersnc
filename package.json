{
  "name": "binbutlersnc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cf": "rm -rf .vercel/output && npx @cloudflare/next-on-pages && echo '_worker.js' > .vercel/output/static/.assetsignore",
    "preview": "npm run build:cf && npx wrangler pages dev .vercel/output/static",
    "preview:local": "npm run build:cf && npx wrangler d1 migrations apply binbutlersnc-db --local && npm run db:seed && npx wrangler pages dev .vercel/output/static --port 8788 --bundle --local-protocol https --binding AUTH_URL=https://localhost:8788 --binding NEXTAUTH_URL=https://localhost:8788",
    "start": "next start",
    "lint": "node ./node_modules/eslint/bin/eslint.js src workers next.config.mjs playwright.config.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "npx tsx scripts/seed-local-db.ts",
    "report:orphan-pending-service-history": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/report-orphan-pending-service-history.ts",
    "audit:service-cycle-recovery": "node scripts/run-local-audit.mjs scripts/audit-service-cycle-recovery.ts",
    "audit:service-cycle-invariants": "node scripts/run-local-audit.mjs scripts/preflight-service-cycle-invariants.ts",
    "audit:billing-drift": "node scripts/run-local-audit.mjs scripts/audit-billing-drift.ts",
    "audit:dispatch-parity": "node scripts/run-local-audit.mjs scripts/audit-dispatch-parity.ts",
    "preflight:confirmed-service-cycle-recovery": "node scripts/run-local-audit.mjs scripts/preflight-confirmed-service-cycle-recovery.ts"
  },
  "dependencies": {
    "@auth/d1-adapter": "^1.11.3",
    "@base-ui/react": "^1.7.0",
    "@geoapify/geocoder-autocomplete": "^3.1.0",
    "@geoapify/react-geocoder-autocomplete": "^3.1.0",
    "@hookform/resolvers": "^5.9.1",
    "@react-google-maps/api": "^2.20.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.34.0",
    "next": "15.2.0",
    "next-auth": "^5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.86.0",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "stripe": "^22.6.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "better-sqlite3": "^12.11.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.0"
  }
}
